{
    "__comment": "MNIST Classification - Baseline (Fixed Architecture)",
    "__description": "Continual learning on MNIST with rotation/scaling transforms",

    "data": "mnist",
    "network": "cnn",
    "n_task": 5,
    "epochs_per_task": 5,
    "batch_size": 128,

    "model_path": "outputs/mnist_baseline",
    "save_iter": 2,
    "log_interval": 1,
    "eval_interval": 2,

    "debug_mode": true,
    "debug_limit": 100,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3,

    "grad_weights": [0.4, 0.4, 0.1],
    "lr_schedule": "constant",
    "lr": 0.0001,
    "task_warmup_enabled": false,
    "awb_enabled": false
}
