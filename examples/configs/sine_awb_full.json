{
    "__comment": "Sine Wave Regression - AWB Full (Architecture Search + Weight Transfer)",
    "__description": "Continual learning with architecture search and A/B matrix transfer",

    "data": "sine",
    "n_task": 5,
    "epochs_per_task": 10,
    "batch_size": 128,
    "n_layers": 4,
    "hln": 64,

    "model_path": "outputs/sine_awb_full",
    "save_iter": 5,
    "log_interval": 1,
    "eval_interval": 5,
    "grad_weights": [0.4, 0.4, 0.1],

    "debug_mode": true,
    "debug_limit": 100,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3,

    "awb_enabled": true,
    "awb_skip_transfer": false,
    "awb_preliminary_epochs": 1,
    "awb_ab_training_epochs": 10,
    "awb_ab_warmup_epochs": 2,
    "awb_ab_lr": 0.001,
    "awb_loss_ratio_threshold": 1.1,
    "force_arch_change": true,

    "lr_schedule": "cosine",
    "lr": 0.0001,
    "task_warmup_enabled": true,
    "task_warmup_epochs": 2,
    "task_warmup_lr_factor": 0.1
}
