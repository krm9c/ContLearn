#!/bin/bash -l
#PBS -l select=8
#PBS -l walltime=8:00:00
#PBS -l filesystems=home:eagle
#PBS -q by-gpu
#PBS -A FOUND4CHEM
#PBS -N contlearn_sophia
#PBS -o sophia_run/logs/job_${PBS_JOBID}.out
#PBS -e sophia_run/logs/job_${PBS_JOBID}.err

# Continual Learning Polaris Job Submission Script
# Runs all configs in parallel across 2 nodes (8 GPUs total)
echo ""
echo "=========================================================================================================="
echo "NEW PBS JOB STARTED"
echo "=========================================================================================================="
echo ""
echo "=========================================="
echo "Polaris Continual Learning Job"
echo "=========================================="
echo "Job ID: ${PBS_JOBID}"
echo "Nodes: ${PBS_NUM_NODES}"
echo "Date: $(date)"
echo "=========================================="
echo ""

# Change to submission directory
cd ${PBS_O_WORKDIR}
echo "Working directory: $(pwd)"

# Set up environment
echo "Setting up environment..."

# Check if conda is available, load module if needed
if ! command -v conda &> /dev/null; then
    echo "Conda not found, loading conda module..."
    module load conda
    echo "Conda loaded: $(which conda)"
fi

# Activate virtual environment
VENV_DIR="$(pwd)/venvs"
if [ ! -d "${VENV_DIR}" ]; then
    echo "ERROR: Virtual environment not found at ${VENV_DIR}"
    echo "Please create it first: /soft/applications/conda/2025-09-25/mconda3/bin/python -m venv ${VENV_DIR}"
    exit 1
fi

echo "Activating virtual environment: ${VENV_DIR}"
source "${VENV_DIR}/base/bin/activate"

echo "Python: $(which python)"
echo ""

# Detect and display GPU information
echo "GPU Information:"
if command -v nvidia-smi &> /dev/null; then
    NUM_GPUS=$(nvidia-smi --query-gpu=count --format=csv,noheader | head -1)
    echo "  Total GPUs detected: ${NUM_GPUS}"
    echo "  GPU details:"
    nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader | sed 's/^/    /'
else
    echo "  nvidia-smi not available"
fi
echo ""

# Create results and logs directories
mkdir -p sophia_run/results
mkdir -p sophia_run/logs

# Pre-download datasets to avoid parallel download conflicts
echo "Pre-downloading datasets..."
python polaris_run/download_datasets.py
echo ""

# Run parallel jobs
echo "Launching parallel jobs..."
bash sophia_run/run_parallel.sh

# Print summary
echo ""
echo "=========================================="
echo "Job Summary"
echo "=========================================="
cat sophia_run/logs/job_summary.txt

echo ""
echo "Job completed at: $(date)"
