#!/bin/bash
#PBS -l select=1:wq:system=polaris
#PBS -l place=scatter
#PBS -l walltime=24:00:00
#PBS -l filesystems=home:eagle
#PBS -q debug
#PBS -A FOUND4CHEM
#PBS -N contlearn_polaris
#PBS -o polaris_run/logs/job_${PBS_JOBID}.out
#PBS -e polaris_run/logs/job_${PBS_JOBID}.err

# Continual Learning Polaris Job Submission Script
# Runs all configs in parallel across 2 nodes (8 GPUs total)

echo "=========================================="
echo "Polaris Continual Learning Job"
echo "=========================================="
echo "Job ID: ${PBS_JOBID}"
echo "Nodes: ${PBS_NUM_NODES}"
echo "Date: $(date)"
echo "=========================================="
echo ""

# Change to submission directory
cd ${PBS_O_WORKDIR}
echo "Working directory: $(pwd)"

# Set up environment
echo "Setting up environment..."

# Set up proxy for compute nodes (required for pip installs on Polaris)
export HTTP_PROXY=http://proxy.alcf.anl.gov:3128
export HTTPS_PROXY=http://proxy.alcf.anl.gov:3128
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
export NO_PROXY=localhost,127.0.0.1,.alcf.anl.gov,.cm.polaris.alcf.anl.gov
export no_proxy=localhost,127.0.0.1,.alcf.anl.gov,.cm.polaris.alcf.anl.gov
echo "Proxy configured: ${HTTP_PROXY}"

# Initialize Lmod (module system) - Polaris uses Lmod
if [ -z "$(type -t module)" ]; then
    # Module function not available, initialize it
    export MODULEPATH=/soft/modulefiles:/opt/cray/pe/lmod/modulefiles/core:/opt/cray/modulefiles
    source /usr/share/lmod/lmod/init/bash 2>/dev/null || \
    source /opt/cray/pe/lmod/lmod/init/bash 2>/dev/null || \
    eval "$(/usr/bin/modulecmd bash purge)" 2>/dev/null || true
fi

# Load conda module
module use /soft/modulefiles
module load conda

# Initialize and activate conda
source /soft/applications/conda/2025-09-25/mconda3/etc/profile.d/conda.sh
conda activate base

# Create venv based on conda environment
CONDA_NAME=$(basename ${CONDA_DEFAULT_ENV:-base})
VENV_DIR="$(pwd)/venvs/${CONDA_NAME}"
echo "CONDA Environment: ${CONDA_DEFAULT_ENV}"
echo "Virtual Environment Directory: ${VENV_DIR}"
mkdir -p "$(pwd)/venvs"

# Create or activate venv
if [ ! -f "${VENV_DIR}/bin/activate" ]; then
    echo "Creating virtual environment at ${VENV_DIR}..."
    python -m venv "${VENV_DIR}"
    source "${VENV_DIR}/bin/activate"

    # Install dependencies with CUDA 12.1 support
    echo "Installing dependencies with CUDA 12.1..."
    bash polaris_run/setup_cuda.sh
else
    echo "Using existing virtual environment at ${VENV_DIR}"
    source "${VENV_DIR}/bin/activate"
fi

echo "Python: $(which python)"
echo "JAX Backend: $(python -c 'import jax; print(jax.default_backend())')"
echo ""

# Create results and logs directories
mkdir -p polaris_run/results
mkdir -p polaris_run/logs

# Run parallel jobs
echo "Launching parallel jobs..."
bash polaris_run/run_parallel.sh

# Print summary
echo ""
echo "=========================================="
echo "Job Summary"
echo "=========================================="
cat polaris_run/logs/job_summary.txt

echo ""
echo "Job completed at: $(date)"
