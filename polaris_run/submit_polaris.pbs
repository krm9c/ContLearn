#!/bin/bash
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=1:00:00
#PBS -l filesystems=home:eagle
#PBS -q debug
#PBS -A FOUND4CHEM
#PBS -N contlearn_polaris
#PBS -o polaris_run/logs/job_${PBS_JOBID}.out
#PBS -e polaris_run/logs/job_${PBS_JOBID}.err

# Continual Learning Polaris Job Submission Script
# Runs all configs in parallel across 2 nodes (8 GPUs total)

echo ""
echo "=========================================================================================================="
echo "NEW PBS JOB STARTED"
echo "=========================================================================================================="
echo ""
echo "=========================================="
echo "Polaris Continual Learning Job"
echo "=========================================="
echo "Job ID: ${PBS_JOBID}"
echo "Nodes: ${PBS_NUM_NODES}"
echo "Date: $(date)"
echo "=========================================="
echo ""

# Change to submission directory
cd ${PBS_O_WORKDIR}
echo "Working directory: $(pwd)"

# Set up environment
echo "Setting up environment..."

# Check if conda is available, load module if needed
if ! command -v conda &> /dev/null; then
    echo "Conda not found, loading conda module..."
    module load conda
    echo "Conda loaded: $(which conda)"
fi

# Activate virtual environment
VENV_DIR="$(pwd)/venvs"
if [ ! -d "${VENV_DIR}" ]; then
    echo "ERROR: Virtual environment not found at ${VENV_DIR}"
    echo "Please create it first: /soft/applications/conda/2025-09-25/mconda3/bin/python -m venv ${VENV_DIR}"
    exit 1
fi

echo "Activating virtual environment: ${VENV_DIR}"
source "${VENV_DIR}/base/bin/activate"

echo "Python: $(which python)"
echo ""

# Create results and logs directories
mkdir -p polaris_run/results
mkdir -p polaris_run/logs

# Run parallel jobs
echo "Launching parallel jobs..."
bash polaris_run/run_parallel.sh

# Print summary
echo ""
echo "=========================================="
echo "Job Summary"
echo "=========================================="
cat polaris_run/logs/job_summary.txt

echo ""
echo "Job completed at: $(date)"
