{
    "_comment": "Self-contained test config for sine regression with AWB (unit tests)",
    "prob": "regression",
    "problem": "vectors",
    "data": "sine",
    "network": "fcnn",
    "loss": "mse",
    "metric": "mse",

    "n_task": 2,
    "epochs_per_task": 2,
    "batch_size": 32,
    "save_iter": 1,
    "lr": 1e-4,
    "optimizer": "adam",

    "n_layers": 3,
    "hln": 32,
    "delta": 0.001,

    "awb_enabled": true,
    "awb_preliminary_epochs": 1,
    "awb_ab_training_epochs": 1,
    "awb_ab_warmup_epochs": 1,
    "awb_averaging_window": 2,

    "flag": [1.0, 1.0],
    "grad_weights": [0.3, 0.6, 0.1],

    "debug_mode": true,
    "debug_limit": 50,
    "len_exp_replay": 100,

    "model_path": "outputs/test/test_sine_awb_model"
}
