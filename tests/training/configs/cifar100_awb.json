{
    "__comment": "Test config for CIFAR-100 classification with AWB enabled",

    "data": "cifar100",

    "n_task": 2,
    "epochs_per_task": 2,
    "save_iter": 1,

    "debug_mode": true,
    "debug_limit": 50,

    "awb_enabled": true,
    "awb_preliminary_epochs": 1,
    "awb_ab_training_epochs": 1,
