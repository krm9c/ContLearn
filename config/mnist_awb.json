{
    "__comment_guide": "See config/TEMPLATE.md for all available options and defaults",

    "data": "mnist",

    "n_task": 10,
    "epochs_per_task": 40,
    "batch_size": 64,

    "model_path": "outputs/mnist_awb_model",
    "save_iter": 2,

    "__comment_awb": "AWB architecture morphing enabled",
    "awb_enabled": true,
    "awb_preliminary_epochs": 2,
    "awb_ab_training_epochs": 2,
    "awb_ab_warmup_epochs": 1,
    "awb_ab_max_iterations": 2,

    "__comment_lr_schedule": "Exponential decay schedule",
    "lr_schedule": "exponential",
    "lr_decay_factor": 0.95,
    "lr_min": 1e-5,

    "debug_mode": true
}
