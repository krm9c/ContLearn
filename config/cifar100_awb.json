{
    "__comment_guide": "See config/TEMPLATE.md for all available options and defaults",

    "data": "cifar100",

    "n_task": 10,
    "epochs_per_task": 40,

    "__comment_arch": "100 classes architecture",
    "feed_sizes": [2304, 512, 256, 100],
    "awb_arch": [2304, 512, 256, 100],
    "n_class": 100,

    "model_path": "outputs/cifar100_awb_model",
    "save_iter": 2,

    "awb_enabled": true,
    "awb_preliminary_epochs": 2,
    "awb_ab_training_epochs": 2,
    "awb_ab_warmup_epochs": 1,
    "awb_ab_max_iterations": 2,

    "lr_schedule": "exponential",
    "lr_decay_factor": 0.95,
    "lr_min": 1e-5,

    "debug_mode": true
}
