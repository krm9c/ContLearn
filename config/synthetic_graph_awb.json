{
    "data": "synthetic",
    "prob": "classification",
    "problem": "graph",
    "network": "gcn",
    "n_task": 2,
    "epochs_per_task": 2,
    "batch_size": 20,
    "n_class": 10,
    "class_per_task": 2,
    "gcn_sizes": [5, 128],
    "feed_sizes": [128, 128, 128, 10],
    "flag": [1.0, 1.0],
    "loss": "class",
    "metric": "class",
    "save_iter": 10,
    "model_path": "outputs/synthetic_graph_awb_model",
    "len_exp_replay": 200000,

    "__comment_synthetic_dataset": "Synthetic graph dataset settings",
    "num_graphs": 1000,
    "num_channels": 5,
    "avg_num_nodes": 2,
    "num_classes": 10,

    "__comment_awb": "AWB (Adaptive Weight Basis) settings for GCN",
    "awb_enabled": true,
    "awb_preliminary_epochs": 2,
    "awb_ab_training_epochs": 2,
    "awb_ab_warmup_epochs": 2,
    "awb_ab_max_iterations": 1,
    "awb_averaging_window": 10,

    "__comment_arch_search": "Architecture search settings for GCN",
    "arch_search_epochs": 2,
    "arch_search_lr": 1e-4,
    "arch_search_step_size_gcn": 10,
    "arch_search_step_size_mlp": 10,
    "arch_search_max_iter": 2,
    "arch_search_averaging_window": 15,
    "arch_search_loss_threshold": 0.6,

    "__comment_optimizer": "Optimizer settings",
    "optimizer": "adamw",
    "lr": 1e-4,
    "weight_decay": 1e-4,

    "debug_mode": true,
    "debug_limit": 100
}
