{
    "data": "cifar10",
    "prob": "classification",
    "problem": "vectors",
    "network": "cnn",
    "n_task": 2,
    "epochs_per_task": 3,
    "batch_size": 32,
    "filter_size": 3,
    "channel_out": 32,
    "channel_in": 3,
    "input_size": 32,
    "feed_sizes": [2304, 512, 256, 10],
    "flag": [1.0, 1.0],
    "loss": "class",
    "metric": "class",
    "save_iter": 1,
    "model_path": "outputs/test_cifar10_model",
    "len_exp_replay": 500,
    "n_class": 10,
    "awb_enabled": false,
    "debug_mode": true,
    "debug_limit": 100,

    "optimizer": "adam",
    "lr": 1e-4,
    "lr_schedule": "constant",

    "grad_weights": [0.01, 0.98, 0.1]
}
