{
    "__comment": "TEST CONFIG: Sine AWB - Minimal epochs for quick testing",
    "data": "sine",
    "n_task": 3,
    "epochs_per_task": 10,
    "batch_size": 512,
    "n_layers": 4,
    "hln": 32,

    "model_path": "runs__/tests/results/sine_test_awb",
    "save_iter": 5,
    "log_interval": 1,
    "eval_interval": 5,
    "grad_weights": [0.4, 0.4, 0.1],
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3,

    "awb_enabled": true,
    "awb_skip_transfer": false,
    "awb_preliminary_epochs": 1,
    "awb_ab_training_epochs": 5,
    "awb_ab_lr": 0.001,
    "awb_loss_ratio_threshold": 1.1,
    "force_arch_change": true,
    "lr_schedule": "cosine",
    "lr": 0.001,
    "task_warmup_enabled": true,
    "task_warmup_epochs": 2,
    "task_warmup_lr_factor": 0.1
}
