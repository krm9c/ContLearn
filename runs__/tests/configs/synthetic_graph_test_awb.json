{
    "__comment": "TEST CONFIG: Synthetic Graph AWB - Minimal epochs for quick testing",
    "data": "synthetic",
    "problem": "graph",
    "network": "gcn",
    "n_task": 3,
    "epochs_per_task": 5,
    "batch_size": 512,

    "model_path": "runs__/tests/results/synthetic_graph_test_awb",
    "save_iter": 2,
    "log_interval": 1,
    "eval_interval": 2,
    "grad_weights": [0.4, 0.4, 0.1],
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": false,
    "prefetch_size": 3,

    "awb_enabled": true,
    "awb_skip_transfer": false,
    "awb_preliminary_epochs": 2,
    "awb_ab_training_epochs": 3,
    "awb_ab_lr": 0.001,
    "awb_loss_ratio_threshold": 1.1,
    "lr_schedule": "cosine",
    "lr": 0.001,
    "task_warmup_enabled": true,
    "task_warmup_epochs": 1,
    "task_warmup_lr_factor": 0.1
}
