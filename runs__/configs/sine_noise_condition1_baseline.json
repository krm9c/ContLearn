{
    "__comment": "CONDITION 1: Baseline with Noise (Experiment 3)",
    "__comment_": "Fixed arch, constant LR, no warm start, increasing noise per task",
    "data": "sine",
    "n_task": 5,
    "epochs_per_task": 500,
    "batch_size": 1024,
    "n_layers": 4,
    "hln": 64,

    "noise_enabled": true,
    "noise_scale": 0.1,
    "noise_increment": 0.05,

    "model_path": "runs__/experiments/sine_noise/results/sine_noise_condition1",
    "save_iter": 50,
    "log_interval": 1,
    "eval_interval": 50,
    "grad_weights": [
        0.4,
        0.4,
        0.1
    ],
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3,

    "lr_schedule": "constant",
    "lr": 0.0001,
    "task_warmup_enabled": false,
    "awb_enabled": false
}
