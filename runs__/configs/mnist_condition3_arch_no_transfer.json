{
    "__comment": "CONDITION 3: Architecture Search Only",
    "__comment_": "AWB arch search, random reinit (no A/B transfer, no warmup)",
    "data": "mnist",
    "n_task": 10,
    "epochs_per_task": 20,
    "batch_size": 1024,
    "save_iter": 5,
    "log_interval": 1,
    "eval_interval": 5,

    "model_path": "runs__/kkt/results/mnist_condition3",
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3,
    "grad_weights": [0.4, 0.4, 0.1],
    "lr_schedule": "constant",
    "lr": 0.0001,
    "task_warmup_enabled": false,

    "awb_enabled": true,
    "awb_skip_transfer": true,
    "awb_preliminary_epochs": 1,
    "awb_ab_warmup_epochs": 0,
    "awb_loss_ratio_threshold": 1.1,
    "force_arch_change": false
}