{
    "__comment": "CONDITION 3: Tuned AWB for CNN",
    "__comment_": "AWB without transfer",
    "data": "mnist",
    "n_task": 10,
    "epochs_per_task": 200,
    "batch_size": 512,
    
    
    
    "model_path": "runs__/kkt/results/mnist_condition4",
    "save_iter": 50,
    "log_interval": 1,
    "eval_interval": 50,
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3,
    
    
    "grad_weights": [
        0.4,
        0.4,
        0.1
    ],
    
    
    "lr_schedule": "constant",
    "lr": 0.0001,
    "force_arch_change": false,
    "task_warmup_enabled":false,
    "awb_enabled": true,
    "awb_skip_transfer": true
}