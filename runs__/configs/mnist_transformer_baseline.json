{
    "__comment": "Transformer baseline on MNIST",
    "data": "mnist",
    "network": "transformer",
    "n_task": 10,
    "task_warmup_epoch": 2,
    "epochs_per_task": 20,
    "batch_size": 16,
    "save_iter": 5,
    "log_interval": 1,
    "eval_interval": 5,

    "transformer_seq_len": 784,
    "transformer_token_dim": 1,
    "transformer_embed_dim": 128,
    "transformer_n_heads": 4,
    "transformer_mlp_dim": 256,
    "transformer_n_layers": 2,

    "model_path": "runs__/polaris/results/mnist_transformer",
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3,

    "grad_weights": [0.4, 0.4, 0.1],
    "lr_schedule": "constant",
    "lr": 0.0001,
    "task_warmup_enabled": false,
    "awb_enabled": true,
    "awb_ab_warmup_epochs": 3,
    "checkpoint_interval": 1,
    "resume_latest": false,
    "resume_from": "runs__/polaris/results/mnist_transformer_checkpoints/main_checkpoint_task0_epoch19_records.pkl",
    "awb_debug_epoch_arch": true,
    "debug_epoch_arch_interval": 1,
    "debug_epoch_arch_prefix": "AWB",
    "arch_search_verbose": true
}
