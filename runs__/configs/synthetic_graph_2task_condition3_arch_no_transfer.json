{
    "__comment": "CONDITION 3: Arch Search Only (2-task synthetic graph)",
    "__comment_": "Architecture search at task boundaries, random reinit (no AWB transfer)",
    "__comment__": "Task-shift: Same 5 classes with progressive perturbations",
    "data": "synthetic_taskshift",
    "problem": "graph",
    "network": "gcn",
    "n_task": 2,
    "epochs_per_task": 400,
    "batch_size": 64,

    "num_graphs": 1000,
    "num_channels": 10,
    "avg_num_nodes": 20,
    "num_classes": 5,
    "feature_noise_base": 0.1,
    "edge_dropout_base": 0.05,
    "feature_shift_base": 0.05,

    "gcn_sizes": [10, 64, 64],
    "mlp_sizes": [64, 64, 32, 5],

    "model_path": "runs__/tests/results/synthetic_graph_2task_condition3",
    "save_iter": 25,
    "log_interval": 1,
    "eval_interval": 25,
    "grad_weights": [0.4, 0.4, 0.1],
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": false,

    "awb_enabled": true,
    "awb_skip_transfer": true,
    "awb_preliminary_epochs": 1,
    "awb_loss_ratio_threshold": 1.1,
    "force_arch_change": true,
    "lr_schedule": "constant",
    "lr": 0.001,
    "task_warmup_enabled": false
}
