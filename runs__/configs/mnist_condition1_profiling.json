{
    "__comment": "CONDITION 1: Baseline with PROFILING ENABLED",
    "__comment_": "For identifying GPU utilization bottlenecks",
    "data": "mnist",
    "n_task": 2,
    "epochs_per_task": 20,
    "batch_size": 512,

    "model_path": "runs__/profiling/results/mnist_condition1_profile",
    "save_iter": 5,
    "log_interval": 1,
    "eval_interval": 5,
    "debug_mode": true,
    "debug_limit": 5000,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3,

    "grad_weights": [0.4, 0.4, 0.1],

    "lr_schedule": "constant",
    "lr": 0.0001,
    "task_warmup_enabled": false,
    "awb_enabled": false,

    "profiling_enabled": true,
    "detailed_profiling": true
}
