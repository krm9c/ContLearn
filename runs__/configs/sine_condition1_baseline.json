{
    "__comment": "CONDITION 1: Baseline Hamiltonian (No Smoothness)",

    "__comment_": "Fixed arch, constant LR, no warm start",
    "data": "sine",
    "n_task": 10,
    "epochs_per_task": 200,
    "batch_size": 1024,
    "n_layers": 4,
    "hln": 64,


    "model_path": "runs__/kkt/results/sine_condition1",
    "save_iter": 50,
    "log_interval": 1,
    "eval_interval": 50,
    "grad_weights": [
        0.4,
        0.4,
        0.1
    ],
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3,

    "lr_schedule": "constant",
    "lr": 0.0001,
    "task_warmup_enabled": false,
    "awb_enabled": false
}