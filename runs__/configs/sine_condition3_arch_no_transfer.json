{
    "__comment": "CONDITION 3: Architecture Change, No Transfer",
    "__comment_": "Arch search enabled, skip A/B training, random init after arch change",
    "data": "sine",
    "n_task": 10,
    "epochs_per_task": 200,
    "batch_size": 1024,


    "model_path": "runs__/kkt/results/sine_condition3",
    "save_iter": 50,
    "log_interval": 1,
    "eval_interval": 50,
    "grad_weights": [
        0.4,
        0.4,
        0.1
    ],
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3,

    "__comment_": "the modifications for different conditions",
    "awb_enabled": true,
    "awb_skip_transfer": true,
    "awb_preliminary_epochs": 30,
    "awb_loss_ratio_threshold": 1.1,
    "lr_schedule": "constant",
    "lr": 0.0001,
    "warmup_epochs": 0
}