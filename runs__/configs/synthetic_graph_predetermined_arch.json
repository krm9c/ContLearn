{
    "_comment": "AWB with predetermined architecture - testing instability fix",
    "_comment2": "LR=0.001, AB_LR=0.0001, grad_clip=1.0, batch_size=128, AB_epochs=150 (extended)",
    "prob": "classification",
    "problem": "graph",
    "data": "synthetic_taskshift",
    "network": "gcn",
    "loss": "class",
    "metric": "class",

    "n_task": 3,
    "epochs_per_task": 200,
    "batch_size": 128,
    "save_iter": 5,
    "eval_interval": 5,
    "log_interval": 5,
    "lr": 0.0001,
    "optimizer": "adam",
    "gradient_clip_norm": 1.0,

    "gcn_sizes": [10, 32, 32],
    "feed_sizes": [32, 32, 16, 5],
    "n_class": 5,

    "num_graphs": 500,
    "num_channels": 10,
    "avg_num_nodes": 15,
    "num_classes": 5,
    "train_test_split": 0.8,

    "perturbation_mode": "linear",
    "feature_noise_base": 0.02,
    "edge_dropout_base": 0.01,
    "feature_shift_base": 0.01,

    "awb_enabled": true,
    "awb_preliminary_epochs": 5,
    "awb_ab_training_epochs": 150,
    "awb_ab_warmup_epochs": 50,
    "awb_ab_lr": 0.0001,
    "force_arch_change": true,

    "_comment3": "Predetermined architecture bypasses search - uses exact arch from previous run",
    "awb_predetermined_arch": {
        "1": {"gcn_sizes": [10, 72, 72], "feed_sizes": [72, 172, 196, 5]},
        "2": {"gcn_sizes": [10, 142, 142], "feed_sizes": [142, 332, 316, 5]}
    },

    "task_warmup_enabled": true,
    "task_warmup_epochs": 20,
    "task_warmup_lr_factor": 0.1,

    "grad_weights": [0.5, 0.5, 0.0],
    "use_jax_prefetch": false,

    "_comment4": "V training Adam betas: lower beta1 for faster adaptation after warmup->main transition",
    "awb_v_adam_beta1": 0.5,
    "awb_v_adam_beta2": 0.999,

    "model_path": "outputs/synthetic_graph_predetermined_arch_extended_ab"
}
