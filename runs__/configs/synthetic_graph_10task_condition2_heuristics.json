{
    "__comment": "CONDITION 2: Heuristics (10-task synthetic graph)",
    "__comment_": "Fixed arch, cosine LR, warmup, adaptive grad weights",
    "__comment__": "Task-shift: Same 5 classes with progressive perturbations",
    "__comment_update": "Updated settings based on successful 3-task experiments (lr=0.0001, batch=128, warmup=20)",
    "data": "synthetic_taskshift",
    "problem": "graph",
    "network": "gcn",
    "n_task": 10,
    "epochs_per_task": 200,
    "batch_size": 128,

    "num_graphs": 500,
    "num_channels": 10,
    "avg_num_nodes": 15,
    "num_classes": 5,
    "train_test_split": 0.8,

    "perturbation_mode": "linear",
    "feature_noise_base": 0.02,
    "edge_dropout_base": 0.01,
    "feature_shift_base": 0.01,

    "gcn_sizes": [10, 32, 32],
    "feed_sizes": [32, 32, 16, 5],
    "n_class": 5,

    "model_path": "runs__/tests/results/synthetic_graph_10task_condition2",
    "save_iter": 5,
    "log_interval": 5,
    "eval_interval": 5,
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": false,

    "lr_schedule": "cosine",
    "lr": 0.0001,
    "optimizer": "adam",
    "gradient_clip_norm": 1.0,

    "grad_weights": [0.4, 0.4, 0.1],

    "task_warmup_enabled": true,
    "task_warmup_epochs": 20,
    "task_warmup_lr_factor": 0.1,

    "awb_enabled": false
}
