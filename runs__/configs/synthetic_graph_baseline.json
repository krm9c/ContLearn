{
    "_comment": "Baseline (no AWB) for comparison with AWB predetermined architecture run",
    "_comment2": "Settings matched to predetermined_arch.json for fair comparison",
    "prob": "classification",
    "problem": "graph",
    "data": "synthetic_taskshift",
    "network": "gcn",
    "loss": "class",
    "metric": "class",

    "n_task": 3,
    "epochs_per_task": 200,
    "batch_size": 128,
    "save_iter": 5,
    "eval_interval": 5,
    "log_interval": 5,
    "lr": 0.0001,
    "optimizer": "adam",
    "gradient_clip_norm": 1.0,

    "gcn_sizes": [10, 32, 32],
    "feed_sizes": [32, 32, 16, 5],
    "n_class": 5,

    "num_graphs": 500,
    "num_channels": 10,
    "avg_num_nodes": 15,
    "num_classes": 5,
    "train_test_split": 0.8,

    "perturbation_mode": "linear",
    "feature_noise_base": 0.02,
    "edge_dropout_base": 0.01,
    "feature_shift_base": 0.01,

    "awb_enabled": false,

    "task_warmup_enabled": true,
    "task_warmup_epochs": 20,
    "task_warmup_lr_factor": 0.1,

    "grad_weights": [0.5, 0.5, 0.0],
    "use_jax_prefetch": false,

    "model_path": "outputs/synthetic_graph_baseline"
}
