{
    "__comment": "CONDITION 2: Smoothness via Heuristics",
    "__comment_": "Fixed arch, cosine LR schedule, warm start",
    "__comment__": "Task-shift: Same 5 classes with progressive perturbations (noise, edge dropout, feature shift)",
    "data": "synthetic_taskshift",
    "problem": "graph",
    "network": "gcn",
    "n_task": 2,
    "epochs_per_task": 200,
    "batch_size": 64,

    "num_graphs": 2000,
    "num_channels": 10,
    "avg_num_nodes": 20,
    "num_classes": 5,
    "feature_noise_base": 0.1,
    "edge_dropout_base": 0.05,
    "feature_shift_base": 0.05,

    "gcn_sizes": [10, 64, 64],
    "mlp_sizes": [64, 64, 32, 5],

    "model_path": "runs__/analysis/data_analysis/synthetic_taskshift/condition2",
    "save_iter": 50,
    "log_interval": 1,
    "eval_interval": 25,
    "grad_weights": [0.4, 0.4, 0.1],
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": false,
    "prefetch_size": 3,

    "lr_schedule": "cosine",
    "lr": 0.01,
    "task_warmup_enabled": true,
    "task_warmup_epochs": 25,
    "task_warmup_lr_factor": 0.1,
    "awb_enabled": false
}
