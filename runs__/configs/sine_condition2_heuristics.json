{
    "__comment": "CONDITION 2: Smoothness via Heuristics",
    "__comment_": "Fixed arch, cosine LR schedule, warm start",
    "data": "sine",
    "n_task": 10,
    "epochs_per_task": 500,
    "batch_size": 1024,
    "n_layers": 4,
    "hln": 64,



    "model_path": "runs__/kkt/results/sine_condition2",
    "save_iter": 50,
    "log_interval": 1,
    "eval_interval": 50,
    "grad_weights": [
        0.4,
        0.4,
        0.1
    ],
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3,

    "lr_schedule": "cosine",
    "lr": 0.0001,
    "task_warmup_enabled": true,
    "task_warmup_epochs": 25,
    "task_warmup_lr_factor": 0.1,
    "awb_enabled": false
}
