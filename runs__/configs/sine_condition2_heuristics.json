{
    "__comment": "CONDITION 2: Smoothness via Heuristics",
    "__comment_": "Fixed arch, cosine LR schedule, warm start, adaptive grad weights",
    "data": "sine",
    "n_task": 10,
    "epochs_per_task": 200,
    "batch_size": 1024,


    "model_path": "runs__/kkt/results/sine_condition2",
    "save_iter": 50,
    "log_interval": 1,
    "eval_interval": 50,
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3,

    "__comment_": "the modifications for different conditions",
    "lr_schedule": "cosine",
    "lr": 0.0001,
    "awb_enabled": false,

    "__comment__": "Task warmup configuration (corrected keys)",
    "task_warmup_enabled": true,
    "task_warmup_epochs": 33,
    "task_warmup_lr_factor": 0.1,
    "warmup_grad_weights": [1.0, 0.0, 0.0],

    "__comment___": "Adaptive gradient weights configuration",
    "adaptive_grad_weights_enabled": true,
    "grad_weights_base": [0.4, 0.4, 0.1],
    "grad_weights_max_current": 0.7,
    "grad_weights_min_experience": 0.2,
    "grad_weights_loss_ratio_threshold": 1.2
}
