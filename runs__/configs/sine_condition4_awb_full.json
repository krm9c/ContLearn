{
    "__comment": "CONDITION 4: Full AWB (Architecture + Transfer)",
    "__comment_": "Arch search + A/B training for knowledge transfer",
    "data": "sine",
    "n_task": 10,
    "epochs_per_task": 200,
    "batch_size": 1024,
    "n_layers": 4,
    "hln": 64,

    "model_path": "runs__/kkt/results/sine_condition4",
    "save_iter": 50,
    "log_interval": 1,
    "eval_interval": 50,
    "grad_weights": [
        0.4,
        0.4,
        0.1
    ],
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3,

    "awb_enabled": true,
    "awb_skip_transfer": false,
    "awb_preliminary_epochs": 30,
    "awb_ab_training_epochs": 500,
    "awb_ab_lr": 0.001,
    "awb_loss_ratio_threshold": 1.1,
    "force_arch_change": true,
    "lr_schedule": "cosine",
    "lr": 0.0001,
    "task_warmup_enabled": true,
    "task_warmup_epochs": 25,
    "task_warmup_lr_factor": 0.1
}
