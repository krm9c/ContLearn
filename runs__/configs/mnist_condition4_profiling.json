{
    "__comment": "CONDITION 4: AWB Full - Profiling config",
    "__comment_": "AWB arch search + A/B transfer with profiling enabled",
    "data": "mnist",
    "n_task": 3,
    "epochs_per_task": 10,
    "batch_size": 1024,

    "model_path": "runs__/profiling/results/mnist_condition4_profile",
    "save_iter": 50,
    "log_interval": 10,
    "eval_interval": 50,
    "debug_mode": true,
    "debug_limit": 10000,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3,

    "grad_weights": [0.4, 0.4, 0.1],

    "lr_schedule": "cosine",
    "lr": 0.0001,
    "task_warmup_enabled": true,
    "task_warmup_epochs": 3,
    "task_warmup_lr_factor": 0.001,

    "awb_enabled": true,
    "awb_skip_transfer": false,
    "awb_preliminary_epochs": 1,
    "awb_ab_training_epochs": 5,
    "awb_ab_warmup_epochs": 2,
    "awb_ab_lr": 0.001,
    "awb_loss_ratio_threshold": 1.1,
    "force_arch_change": true,

    "profiling_enabled": true,
    "detailed_profiling": true
}
