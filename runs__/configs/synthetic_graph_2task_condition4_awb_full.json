{
    "__comment": "CONDITION 4: AWB Full (2-task synthetic graph)",
    "__comment_": "Architecture search + AWB transfer + heuristics",
    "data": "synthetic",
    "problem": "graph",
    "network": "gcn",
    "n_task": 2,
    "epochs_per_task": 125,
    "batch_size": 64,


    "model_path": "runs__/results/synthetic_graph_2task_condition4",
    "save_iter": 25,
    "log_interval": 1,
    "eval_interval": 25,
    "grad_weights": [1.0, 1.0, 1e-05],
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": false,

    "awb_enabled": true,
    "awb_skip_transfer": false,
    "awb_preliminary_epochs": 1,
    "awb_ab_training_epochs": 100,
    "awb_loss_ratio_threshold": 1.1,
    "lr_schedule": "cosine",
    "lr": 0.001,
    "task_warmup_enabled": true,
    "task_warmup_epochs": 25,
    "task_warmup_lr_factor": 0.1
}