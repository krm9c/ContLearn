{
    "__comment": "CONDITION 2: Heuristics (2-task synthetic graph)",
    "__comment_": "Fixed arch, cosine LR, warmup, adaptive grad weights",
    "data": "synthetic",
    "problem": "graph",
    "network": "gcn",
    "n_task": 2,
    "epochs_per_task": 125,
    "batch_size": 20,

    "num_graphs": 10000,
    "num_channels": 5,
    "avg_num_nodes": 2,
    "num_classes": 10,
    "class_per_task": 5,

    "model_path": "runs__/results/synthetic_graph_2task_condition2",
    "save_iter": 25,
    "log_interval": 1,
    "eval_interval": 25,
    "grad_weights": [1.0, 1.0, 1e-05],
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": false,

    "lr_schedule": "cosine",
    "lr": 0.0001,
    "task_warmup_enabled": true,
    "warmup_epochs": 15,
    "awb_enabled": false
}
