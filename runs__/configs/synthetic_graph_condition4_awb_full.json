{
    "__comment": "CONDITION 4: Full AWB (Architecture + Transfer)",
    "__comment_": "Arch search + A/B training for knowledge transfer",
    "data": "synthetic",
    "problem": "graph",
    "network": "gcn",
    "n_task": 10,
    "epochs_per_task": 250,
    "batch_size": 2048,

    "model_path": "runs__/kkt/results/synthetic_graph_condition4",
    "save_iter": 50,
    "log_interval": 1,
    "eval_interval": 50,
    "grad_weights": [
        0.4,
        0.4,
        0.1
    ],
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3,

    "__comment_": "the modifications for different conditions",
    "awb_enabled": true,
    "awb_skip_transfer": false,
    "awb_preliminary_epochs": 30,
    "awb_ab_training_epochs": 100,
    "awb_loss_ratio_threshold": 1.1,
    "lr_schedule": "cosine",
    "lr": 0.0001,
    "warmup_epochs": 25,
    "lr_warmup_factor": 0.1
}