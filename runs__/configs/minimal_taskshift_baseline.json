{
    "_comment": "Minimal task-shift graph baseline - verify no train/test gap",
    "prob": "classification",
    "problem": "graph",
    "data": "synthetic_taskshift",
    "network": "gcn",
    "loss": "class",
    "metric": "class",

    "n_task": 3,
    "epochs_per_task": 50,
    "batch_size": 20,
    "save_iter": 10,
    "eval_interval": 10,
    "log_interval": 10,
    "lr": 1e-3,
    "optimizer": "adam",

    "gcn_sizes": [10, 32],
    "feed_sizes": [32, 16, 5],
    "n_class": 5,

    "awb_enabled": false,
    "task_warmup_enabled": false,
    "grad_weights": [0.5, 0.5, 0.0],

    "num_graphs": 400,
    "num_channels": 10,
    "avg_num_nodes": 10,
    "num_classes": 5,
    "train_test_split": 0.8,

    "perturbation_mode": "linear",
    "feature_noise_base": 0.05,
    "edge_dropout_base": 0.02,
    "feature_shift_base": 0.02,

    "use_jax_prefetch": false,

    "model_path": "outputs/minimal_taskshift_baseline"
}
