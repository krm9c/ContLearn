{
    "__comment": "Smoothness via Heuristics",
    "__comment_": "Fixed arch, cosine LR schedule, warm start",
    "data": "mnist",
    "n_task": 10,
    "epochs_per_task": 500,
    "batch_size": 256,
    "awb_enabled": false,
    "lr_schedule": "cosine",
    "lr": 0.0001,
    "warmup_epochs": 50,
    "lr_warmup_factor": 0.1,
    "model_path": "experiments/results/mnist/condition2_heuristics",
    "save_iter": 50,
    "grad_weights": [
        0.01,
        0.98,
        0.1
    ],
    "debug_mode": false,
    "experiment_name": "mnist_condition2_heuristics",
    "per_task_eval_enabled": true
}