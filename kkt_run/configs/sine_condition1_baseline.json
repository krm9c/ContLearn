{
    "__comment": "CONDITION 1: Baseline Hamiltonian (No Smoothness)",
    "__comment_": "Fixed arch, constant LR, no warm start",
    "__optimization": "JAX prefetching enabled, eval_interval=50 for performance",
    "data": "sine",
    "n_task": 10,
    "epochs_per_task": 200,
    "batch_size": 1024,
    "awb_enabled": false,
    "lr_schedule": "constant",
    "lr": 0.0001,
    "warmup_epochs": 0,
    "task_warmup_enabled": false,
    "model_path": "kkt_run/results/sine_condition1",
    "save_iter": 50,
    "log_interval": 1,
    "eval_interval": 50,
    "grad_weights": [
        0.3,
        0.6,
        0.1
    ],
    "debug_mode": false,
    "per_task_eval_enabled": true,
    "use_jax_prefetch": true,
    "prefetch_size": 3
}