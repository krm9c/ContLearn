{
    "__comment": "FORCED AWB TEST - Guarantees architecture changes and A/B training",
    "__comment_": "Threshold 0.90 triggers easily (forces architecture changes)",
    "data": "sine",
    "prob": "regression",
    "problem": "vectors",
    "network": "fcnn",
    "n_task": 3,
    "epochs_per_task": 5,
    "batch_size": 16,
    "awb_enabled": true,
    "awb_skip_transfer": false,
    "awb_preliminary_epochs": 2,
    "awb_ab_training_epochs": 2,
    "awb_loss_ratio_threshold": 0.90,
    "awb_search_hidden_sizes": [50, 75, 100, 125],
    "lr_schedule": "constant",
    "lr": 0.0001,
    "warmup_epochs": 0,
    "model_path": "kkt_run/results/sine_awb_forced_debug",
    "save_iter": 1,
    "grad_weights": [0.01, 0.98, 0.1],
    "debug_mode": true,
    "debug_limit": 50,
    "per_task_eval_enabled": true,
    "hln": 50,
    "n_layers": 4
}
