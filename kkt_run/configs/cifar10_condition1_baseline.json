{
    "__comment": "CONDITION 1: Baseline Hamiltonian (No Smoothness)",
    "__comment_": "Fixed arch, constant LR, no warm start",
    "data": "cifar10",
    "n_task": 10,
    "epochs_per_task": 150,
    "batch_size": 1024,
    "awb_enabled": false,
    "lr_schedule": "constant",
    "lr": 0.0001,
    "warmup_epochs": 0,
    "task_warmup_enabled": false,
    "model_path": "kkt_run/results/cifar10_condition1",
    "save_iter": 50,
    "log_interval": 1,
    "eval_interval": 50,
    "grad_weights": [
        0.3,
        0.6,
        0.1
    ],
    "debug_mode": false,
    "per_task_eval_enabled": true
}