{
    "__comment_guide": "See config/TEMPLATE.md for all available options and defaults",

    "__comment_data": "Dataset selection - auto-sets prob, problem, network, loss, metric",
    "data": "synthetic",

    
    "__comment_training": "Experimental parameters",
    "n_task": 10,
    "epochs_per_task": 1000,
    "batch_size": 64,


    "model_path": "outputs/synthetic_graph_model",
    "save_iter": 10,


    "__comment_awb": "AWB architecture morphing disabled",
    "awb_enabled": false,


    "__comment_optimizer": "AdamW with weight decay for regularization",
    "optimizer": "adamw",
    "lr": 1e-3,
    "lr_min": 1e-6,
    "lr_schedule": "cosine",
    "weight_decay": 1e-4,
    "__comment_warmup": "Task transition warmup: new task samples only, then experience replay",
    "task_warmup_enabled": true,
    "task_warmup_epochs": 5,
    "task_warmup_lr_factor": 0.1,
    "warmup_grad_weights": [
        1.0,
        0.0,
        0.0
    ],
    "main_grad_weights": [
        0.3,
        0.6,
        0.1
    ],
    "__comment_overrides": "Optional overrides (see TEMPLATE.md)",
    "debug_mode": false


}
