    "lr_schedule": "constant",
    "lr": 0.0001,
    "warmup_epochs": 0,
    "model_path": "kkt_run/results/permuted_mnist_condition4",
    "save_iter": 50,
    "grad_weights": [0.01, 0.98, 0.1],
    "debug_mode": false,
    "per_task_eval_enabled": true
}
