{
    "__comment_guide": "See config/TEMPLATE.md for all available options and defaults",

    "__comment_data": "Dataset selection - auto-sets prob, problem, network, loss, metric",
    "data": "synthetic",

    "__comment_training": "Experimental parameters - same as non-AWB",
    "n_task": 10,
    "epochs_per_task": 100,
    "batch_size": 20,

    "model_path": "outputs/synthetic_graph_awb_model",
    "save_iter": 10,

    "__comment_awb": "AWB architecture morphing enabled",
    "awb_enabled": true,
    "awb_preliminary_epochs": 10,
    "awb_ab_training_epochs": 20,
    "awb_ab_warmup_epochs": 5,
    "awb_ab_max_iterations": 3,
    "awb_v_lr_factor": 0.1,
    "awb_v_warmup_epochs": 5,
    "awb_task_lr_factor": 0.1,
    "awb_task_warmup_epochs": 5,

    "__comment_arch_search": "Architecture search settings",
    "arch_search_epochs": 100,
    "arch_search_lr": 0.001,
    "arch_search_max_iter": 3,

    "__comment_overrides": "Optional overrides (see TEMPLATE.md)",
    "optimizer": "adamw",
    "lr_schedule": "constant",
    "debug_mode": false
}
